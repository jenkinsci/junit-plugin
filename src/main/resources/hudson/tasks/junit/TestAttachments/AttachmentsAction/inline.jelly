<?jelly escape-by-default='true'?>
<!-- shown in the expandable summary of a test, in the style of test-output.jelly -->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <st:adjunct includes="hudson.tasks.junit.TestAttachments.attachments" />
  <div class="jp-code-card">
    <details open="true">
      <summary>
        ${%Attachments}
        <l:icon src="symbol-chevron-forward-outline plugin-ionicons-api" />
      </summary>
      <ul class="junit-attachments__list jenkins-!-margin-top-1">
        <j:forEach var="link" items="${it.links}">
          <li class="junit-attachments__item">
            <l:icon src="symbol-document-outline plugin-ionicons-api" class="junit-attachments__icon" />
            <a href="${rootURL}/${link.url}">${link.name}</a>
            <span class="junit-attachments__size">${link.fileSize}</span>
          </li>
        </j:forEach>
      </ul>
    </details>
  </div>
</j:jelly>
