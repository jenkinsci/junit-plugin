<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
    <st:documentation>
        Failing, skipped and passing test counts as a group of pills, for use in an app bar.
        Counts of zero are left out.
        <st:attribute name="failCount" use="required">
            Number of failing tests.
        </st:attribute>
        <st:attribute name="skipCount" use="required">
            Number of skipped tests.
        </st:attribute>
        <st:attribute name="passCount" use="required">
            Number of passing tests.
        </st:attribute>
    </st:documentation>

    <div class="jp-pills">
        <j:if test="${attrs.failCount gt 0}">
            <div class="jp-pill jenkins-!-error-color" tooltip="${%failing(attrs.failCount)}">
                <l:icon src="symbol-close-outline plugin-ionicons-api" />
                ${attrs.failCount}
            </div>
        </j:if>
        <j:if test="${attrs.skipCount gt 0}">
            <div class="jp-pill jenkins-!-skipped-color" tooltip="${%skipped(attrs.skipCount)}">
                <l:icon src="symbol-skipped plugin-junit" />
                ${attrs.skipCount}
            </div>
        </j:if>
        <j:if test="${attrs.passCount gt 0}">
            <div class="jp-pill jenkins-!-success-color" tooltip="${%passing(attrs.passCount)}">
                <l:icon src="symbol-checkmark-outline plugin-ionicons-api" />
                ${attrs.passCount}
            </div>
        </j:if>
    </div>
</j:jelly>
