<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <st:documentation>
    Button that copies an AI-ready prompt describing a test failure into the user's clipboard.

    <st:attribute name="text" use="required">
      Prompt text to be copied into the clipboard.
    </st:attribute>
  </st:documentation>

  <!-- 'jenkins-copy-button' hooks into core's copy button behaviour, which marks the button as copied on success -->
  <span data-message-insecure="${%copyInsecure}">
    <button class="jenkins-button jenkins-copy-button"
            text="${attrs.text}"
            type="button"
            data-tooltip-append-to-parent="true">
      <span class="jp-copy-prompt-button__icon">
        <l:icon src="symbol-sparkles-outline plugin-ionicons-api" class="jp-copy-prompt-button__idle" />
        <l:icon src="symbol-check" class="jp-copy-prompt-button__done" />
      </span>
      ${%label}
    </button>
  </span>

  <st:adjunct includes="lib.layout.copyButton.copyButton"/>
  <st:adjunct includes="lib.hudson.test.copyAsPromptButton.copyAsPromptButton"/>
</j:jelly>
